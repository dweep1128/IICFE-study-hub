# Names only. Copy to .env locally; on Vercel add them in Project Settings > Environment Variables. See README.md.
# Required
SHEET_ID=
SESSION_SECRET=
# Required on Vercel (locally you can use server/credentials/service-account.json instead)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional
ANTHROPIC_API_KEY=
CHAT_MODEL=
PORT=
# Only for `npm run seed`
DEMO_PASSWORD=
# Advanced overrides (leave blank for the defaults)
GOOGLE_KEY_FILE=
SHEETS_CACHE_MS=
SHEETS_TIMEOUT_MS=
DRIVE_TIMEOUT_MS=
